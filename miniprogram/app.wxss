page { background: #fff8f6; color: #332c29; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 28rpx; padding-bottom: 140rpx; }
.card { background: #fff; border-radius: 28rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 12rpx 34rpx rgba(148,87,78,.07); }
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { color: #8a7f78; font-size: 26rpx; margin-top: 8rpx; }
.section-title { font-size: 30rpx; font-weight: 650; margin-bottom: 22rpx; }
.primary { background: linear-gradient(135deg,#f2857d,#ec675e) !important; color: white !important; border-radius: 999rpx; font-weight: 600; box-shadow:0 10rpx 24rpx rgba(238,105,94,.2); }
.secondary { background: #ffebe8 !important; color: #d65f54 !important; border-radius: 999rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.tag { display: inline-block; padding: 8rpx 18rpx; border-radius: 999rpx; background: #fff0ea; color: #d95345; font-size: 24rpx; margin: 6rpx; }
.muted { color: #8a7f78; }
.empty { text-align: center; padding: 60rpx 20rpx; color: #9c9088; }
button::after { border: none; }
input, textarea { background: #faf6f3; border-radius: 16rpx; padding: 20rpx; box-sizing: border-box; width: 100%; }
