.filter{background:#fff;padding:16rpx 22rpx;border-radius:999rpx;color:#766a64;font-size:24rpx}.quick{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:28rpx}.quick button{background:#fff;border-radius:24rpx;color:#554a46;font-weight:650;padding:24rpx 10rpx}.quick text{display:block;font-size:42rpx;margin-bottom:8rpx}.review{margin-top:20rpx}.manual{background:transparent;color:#c26e63;font-size:24rpx}.timeline{border-left:4rpx solid #f3d4cf;margin:20rpx 0 0 18rpx;padding-left:30rpx}.entry{position:relative;background:#fff;border-radius:24rpx;padding:26rpx;margin-bottom:22rpx}.dot{position:absolute;width:18rpx;height:18rpx;border-radius:50%;background:#ef8b84;left:-41rpx;top:32rpx;border:6rpx solid #fff8f5}.meta{font-size:23rpx;color:#ef7e75;font-weight:650}.food{font-size:34rpx;font-weight:750;margin:12rpx 0}.note{font-size:27rpx;line-height:1.6;margin-top:14rpx}.entry image{width:100%;height:340rpx;border-radius:20rpx;margin-top:16rpx}
