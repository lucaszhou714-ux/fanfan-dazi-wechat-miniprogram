<view class="page"><view class="row"><view><view class="title">我们的饭饭记录</view><view class="subtitle">每一顿，都是两个人的小日常</view></view><picker range="{{filters}}" bindchange="filter"><view class="filter">{{filter}}⌄</view></picker></view>
<view class="quick"><button bindtap="photo"><text>📷</text>拍照记录</button><button bindtap="addText"><text>✍🏻</text>文字记录</button></view>
<view class="card review row" bindtap="report"><view><view class="section-title">本周回顾</view><view class="muted">记录 {{summary.days}} 天 · 外卖 {{summary.takeout}} 次</view></view><text>›</text></view>
<button class="manual" bindtap="addMeal">＋ 补充详细饮食记录</button>
<view wx:if="{{!feed.length}}" class="card empty">第一条饭饭记录，等你来留下</view>
<view class="timeline"><view class="entry" wx:for="{{feed}}" wx:key="id" data-id="{{item.id}}" data-kind="{{item.kind}}" data-own="{{item.own}}" bindtap="edit"><view class="dot"></view><view class="meta">{{item.author}} · {{item.date}} {{item.time}}</view><view class="food">{{item.title}}</view><view wx:if="{{item.kind==='meal'}}" class="muted">{{item.mealType}}<text wx:if="{{item.amount}}"> · ¥{{item.amount}}</text></view><view wx:if="{{item.note}}" class="note">{{item.note}}</view><image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill" data-src="{{item.photo}}" catchtap="preview"/><view><text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view></view></view></view>
