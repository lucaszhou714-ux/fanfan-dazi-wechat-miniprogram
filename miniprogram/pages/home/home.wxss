.date{font-size:24rpx;color:#a09189}.hero{margin-top:30rpx;background:linear-gradient(145deg,#ffe0dc,#fff1ed);padding:36rpx;border-radius:34rpx}.plan{font-size:52rpx;font-weight:750;margin:14rpx 0}.preference{font-size:24rpx;color:#9a7c73;margin-bottom:28rpx}.hero .primary{height:92rpx}.plan-link{background:transparent;color:#bb756b;font-size:24rpx;margin-top:12rpx}.partner{display:flex;align-items:center;justify-content:space-between}.partner>text{font-size:54rpx;color:#ef8b84}.dish{font-size:34rpx;font-weight:700;margin-top:8rpx}.mask{position:fixed;z-index:20;inset:0;background:rgba(50,35,32,.45);display:flex;align-items:flex-end}.sheet{width:100%;background:#fff9f7;border-radius:38rpx 38rpx 0 0;padding:20rpx 34rpx 50rpx;min-height:520rpx}.handle{width:80rpx;height:8rpx;border-radius:9rpx;background:#ddcfca;margin:0 auto 24rpx}.dish-photo{height:330rpx;border-radius:28rpx;background-repeat:no-repeat}.picked{text-align:center;font-size:42rpx;font-weight:750;margin:24rpx 0 8rpx}.center{text-align:center}.remain{font-size:23rpx;color:#ae8b82;margin-top:12rpx}.actions{display:flex;gap:18rpx;margin-top:30rpx}.actions button{flex:1}.loading{height:430rpx;display:flex;align-items:center;justify-content:center;color:#ef6b5b;font-size:30rpx}.success{text-align:center;background:#fff0ea;color:#d85e51;border-radius:20rpx;padding:24rpx;margin-top:26rpx;font-weight:700}
