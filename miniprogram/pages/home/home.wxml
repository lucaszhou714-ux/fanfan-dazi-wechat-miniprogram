<view class="page"><view class="date">{{today}}</view><view class="title">中午吃什么？</view><view class="subtitle">少纠结一点，把时间留给好好吃饭</view>
<view class="hero"><view class="muted">今天的午餐</view><view class="plan">{{latest?(latest.actualDish||latest.dish):plan}}</view><view class="preference">沿用你的预算与忌口设置</view><button class="primary" bindtap="decide">{{latest?'再帮我想想':'帮我决定'}}</button><button class="plan-link" bindtap="goPlan">设置本周计划</button></view>
<view class="card partner" wx:if="{{partnerToday}}"><view><view class="muted">TA 今天吃了</view><view class="dish">{{partnerToday.actualDish||partnerToday.dish}}</view></view><text>💗</text></view>
<view class="card partner" wx:else><view><view class="muted">TA 今天吃了什么？</view><view class="dish">还没有新记录</view></view><text>♡</text></view>
<view class="card row" bindtap="goRecord"><view><view class="section-title">留下这一餐</view><view class="muted">拍照或写一句话，20 秒完成</view></view><text>›</text></view></view>
<view class="mask" wx:if="{{showPicker}}" bindtap="close"><view class="sheet" catchtap="noop"><view class="handle"></view><view wx:if="{{rolling}}" class="loading">正在认真挑选…</view><view wx:elif="{{result}}"><view class="dish-photo" style="{{resultStyle}}"></view><view class="picked">{{result.name}}</view><view class="muted center">{{result.cuisine}} · 约 {{result.price}} 元 · {{result.spicy}}</view><view class="center remain">今天还可换 {{remaining}} 次</view><view wx:if="{{confirmed}}" class="success">✓ 已写入今天的记录</view><view wx:else class="actions"><button class="secondary" disabled="{{remaining<=0}}" bindtap="pick">换一个试试</button><button class="primary" bindtap="accept">就吃这个</button></view></view></view></view>
