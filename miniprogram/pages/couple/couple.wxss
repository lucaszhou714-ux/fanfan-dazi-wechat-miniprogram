.notice{background:#fff1ce;color:#8b641a;border-radius:18rpx;padding:20rpx;margin:24rpx 0;font-size:24rpx}.love{text-align:center;margin-top:30rpx;background:linear-gradient(145deg,#fff,#ffebe8)}.avatars{display:flex;align-items:center;justify-content:center;gap:24rpx}.avatars>view{width:92rpx;height:92rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#ffe0dc;color:#ba665c;font-weight:700}.avatars>text{font-size:42rpx;color:#ef7c73}.love-name{font-size:36rpx;font-weight:750;margin:20rpx 0 8rpx}.days{color:#8d7d76;font-size:26rpx}.days text{color:#ef6b5b;font-size:42rpx;font-weight:800;margin:0 6rpx}.code{font-size:50rpx;letter-spacing:10rpx;font-weight:700;margin:26rpx 0;background:#fff0ea;border-radius:20rpx;padding:18rpx}.reward{text-align:center;background:#fff0ea}.reward-name{font-size:34rpx;font-weight:700;color:#d75f52;margin:14rpx}.reward button{margin-top:22rpx}.section{margin:30rpx 0 16rpx}.settings{padding-top:10rpx;padding-bottom:10rpx}.setting{padding:25rpx 4rpx;border-bottom:1rpx solid #f3ebe7}.setting:last-child{border-bottom:0}.unbind{background:transparent;color:#aaa;font-size:23rpx;margin-top:18rpx}.unbound{text-align:center;margin-top:30rpx}.big-heart{display:block;font-size:100rpx;color:#ef8b84}.unbound button,.card>button{margin-top:24rpx}
.since-edit{text-align:center;color:#a68f87;font-size:23rpx;margin:-10rpx 0 24rpx}
