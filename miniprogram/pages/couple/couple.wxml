<view class="page"><view class="title">我们</view><view class="subtitle">一起吃饭，也一起记录生活</view>
<view wx:if="{{!cloudReady}}" class="notice">当前是本地预览模式，部署云函数后才能绑定两部手机。</view>
<view wx:if="{{couple}}"><view class="card love"><view class="avatars"><view>我</view><text>♥</text><view>TA</view></view><view class="love-name">{{partnerName}}</view><view wx:if="{{couple.status==='bound'}}" class="days">我们来到这里的第 <text>{{days}}</text> 天</view><view wx:else class="muted">把邀请码发给对方，等 TA 来到这里</view><view wx:if="{{couple.status!=='bound'&&couple.inviteCode}}" class="code">{{couple.inviteCode}}</view></view>
<picker mode="date" value="{{couple.since}}" bindchange="sinceChange"><view class="since-edit">相伴起点：{{couple.since}} · 点击调整</view></picker>
<view class="card reward"><view class="muted">本周情侣奖励</view><view class="reward-name">{{rewardResult||'给这周一点小期待'}}</view><button class="secondary" disabled="{{rewardDone}}" bindtap="reward">{{rewardDone?'本周已领取':'领取本周奖励'}}</button></view>
<view class="section-title section">饭饭设置</view><view class="card settings"><view class="setting row" bindtap="profile"><text>我的口味与预算</text><text>›</text></view><view class="setting row" bindtap="report"><text>我们的饮食回顾</text><text>›</text></view><view class="setting row"><text>情侣空间与共享</text><text>›</text></view><view class="setting row"><text>隐私与数据说明</text><text>›</text></view></view><button class="unbind" bindtap="unbind">解除情侣绑定</button></view>
<view wx:else><view class="card unbound"><text class="big-heart">♡</text><view class="section-title">邀请我爱的 TA</view><view class="muted">绑定后可以互看饮食记录、帮对方决定吃什么</view><button class="primary" loading="{{busy}}" bindtap="generate">生成邀请码</button></view><view class="card"><view class="section-title">接受 TA 的邀请</view><input maxlength="6" placeholder="输入 6 位邀请码" bindinput="input"/><button class="secondary" loading="{{busy}}" bindtap="join">加入情侣空间</button></view><view class="card setting row" bindtap="profile"><text>先设置我的口味与预算</text><text>›</text></view></view></view>
