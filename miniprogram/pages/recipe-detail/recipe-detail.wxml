<view class="page" wx:if="{{recipe}}"><view class="hero"><text>{{recipe.emoji}}</text><view class="title">{{recipe.name}}</view><view class="subtitle">{{recipe.minutes}} 分钟 · {{recipe.difficulty}}</view><button class="secondary" bindtap="favorite">{{favorite?'♥ 已收藏':'♡ 收藏菜谱'}}</button></view><view class="card"><view class="section-title">准备食材</view><view class="ingredient" wx:for="{{recipe.ingredients}}" wx:key="*this">• {{item}}</view></view><view class="card"><view class="section-title">开始做</view><view class="step" wx:for="{{recipe.steps}}" wx:key="*this"><text>{{index+1}}</text><view>{{item}}</view></view></view><view class="card tip"><view class="section-title">小菜提示</view>{{recipe.tip}}</view></view>
