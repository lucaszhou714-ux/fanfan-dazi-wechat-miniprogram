.filters{margin-top:28rpx}.filters>view{margin-bottom:26rpx}.select{float:right;color:#ef6b5b}.wheel{width:540rpx;min-height:540rpx;border-radius:40rpx;margin:38rpx auto 20rpx;display:flex;align-items:center;justify-content:center;text-align:center;background:linear-gradient(145deg,#fff,#ffe4d9);box-shadow:0 20rpx 60rpx rgba(239,107,91,.18);border:10rpx solid #fff;overflow:hidden}.wheel text{display:block}.emoji{font-size:90rpx}.dish-photo{width:540rpx;height:320rpx;background-repeat:no-repeat}.result{font-size:40rpx;font-weight:700;margin:20rpx 18rpx 12rpx}.wheel .muted{padding-bottom:22rpx}.spin{animation:pulse .65s infinite alternate}.big{min-height:96rpx;line-height:1.3;font-size:30rpx;padding:20rpx 30rpx}.attempts{text-align:center;color:#8a7f78;font-size:24rpx;margin:0 0 18rpx}.link{background:transparent;color:#8a7f78;font-size:26rpx}@keyframes pulse{to{transform:scale(.96)}}.target{display:flex;background:#f5ece7;border-radius:999rpx;padding:8rpx;margin-top:26rpx}.target text{flex:1;text-align:center;padding:14rpx;border-radius:999rpx}.target .active{background:#fff;color:#ef6b5b;font-weight:700}.forwho{font-size:23rpx;color:#ef6b5b;margin:10rpx 0 20rpx}button[disabled]{opacity:.58}
