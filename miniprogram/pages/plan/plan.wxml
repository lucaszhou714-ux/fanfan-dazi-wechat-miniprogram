<view class="page"><view class="card"><view class="section-title">默认点餐提醒</view><picker mode="time" value="{{reminder}}" bindchange="timeChange"><view class="time">{{reminder}} <text>修改</text></view></picker><view class="subtitle">正式通知还需订阅消息授权</view></view>
<view class="card"><view class="section-title">未来7天</view><view class="day" wx:for="{{days}}" wx:key="key"><view class="dayname"><text>{{item.label}}</text><text class="muted">{{item.date}}</text></view><view class="choices"><text wx:for="{{options}}" wx:for-item="op" wx:key="*this" class="choice {{item.value===op?'active':''}}" data-key="{{item.key}}" data-value="{{op}}" bindtap="choose">{{op}}</text></view></view></view></view>
