.tip{margin-top:28rpx;line-height:1.6;color:#625751}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.metric{margin:0;text-align:center}.metric text{display:block;color:#8a7f78;font-size:23rpx}.metric view{font-size:42rpx;color:#ef6b5b;font-weight:700;margin:12rpx}.bar-row{display:grid;grid-template-columns:80rpx 1fr 40rpx;align-items:center;gap:12rpx;margin:24rpx 0}.bar-row>view{height:18rpx;background:#f5ece7;border-radius:999rpx;overflow:hidden}.bar-row .fill{height:100%;background:#ef6b5b;border-radius:999rpx}.notice{text-align:center;font-size:22rpx;margin-top:26rpx}
