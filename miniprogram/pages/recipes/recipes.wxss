.theme{margin-top:30rpx;padding:34rpx;border-radius:30rpx;background:#473b38;color:#fff}.theme .muted{color:#d9ccc7}.theme-name{font-size:43rpx;font-weight:750;margin:14rpx 0 8rpx}.theme-tip{font-size:25rpx;color:#e9dfdc}.theme button{background:#fff0ea;color:#d25c50;border-radius:999rpx;font-size:24rpx;margin-top:24rpx}.done{font-size:23rpx;color:#e6cbc4;margin-top:20rpx}.section-row{display:flex;justify-content:space-between;align-items:center;margin-top:32rpx}.section-row .section-title{margin:0}.filter{background:#fff;padding:14rpx 22rpx;border-radius:999rpx;font-size:23rpx}.scene-chips{white-space:nowrap;overflow:hidden;margin:18rpx 0}.scene-chips text{display:inline-block;padding:12rpx 20rpx;background:#ffe9e5;color:#c7685d;border-radius:999rpx;font-size:23rpx;margin-right:12rpx}.recipe-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.recipe{position:relative;background:#fff;border-radius:26rpx;padding:26rpx;min-height:220rpx}.emoji{font-size:62rpx}.name{font-size:29rpx;font-weight:700;margin:14rpx 0 7rpx}.heart{position:absolute;right:20rpx;top:20rpx;color:#ef7c73;font-size:38rpx}
