.field-block{margin-top:24rpx}.label{display:block;margin-bottom:12rpx;color:#625751;font-size:27rpx;font-weight:600}.field-block input{height:88rpx;line-height:88rpx;padding:0 24rpx;font-size:28rpx}.field-block textarea{min-height:112rpx;padding:22rpx 24rpx;font-size:28rpx;line-height:1.55}.full-button{width:100%;margin-top:28rpx;min-height:84rpx;font-size:28rpx}.weekly{font-size:38rpx;font-weight:700;color:#ef6b5b;padding:22rpx 0 12rpx}.hint{color:#8a7f78;font-size:25rpx;line-height:1.55}.inline{display:flex;gap:16rpx;align-items:stretch;margin-top:20rpx}.inline input{flex:1;min-width:0;height:84rpx;line-height:84rpx;padding:0 22rpx;font-size:27rpx}.inline .small{flex:0 0 150rpx;width:150rpx;height:84rpx;line-height:84rpx;margin:0;font-size:26rpx;padding:0}.count{margin:20rpx 0}.reward-result{padding:20rpx;border-radius:18rpx;background:#fff8f3;color:#d95345;font-weight:600;line-height:1.5}button[disabled]{opacity:.58}
