<view class="page"><view class="title">饭饭动态</view><view class="subtitle">食堂随手拍，也能成为两个人的小日常</view><view class="card composer"><textarea value="{{text}}" placeholder="今天吃了什么？味道怎么样？" bindinput="input" maxlength="200"/><image wx:if="{{photo}}" src="{{photo}}" mode="aspectFill"/><view class="row"><button class="secondary photo" bindtap="choose">📷 拍照 / 选图</button><button class="primary publish" loading="{{posting}}" bindtap="post">发布</button></view></view><view wx:if="{{!moments.length}}" class="card empty">第一条饭饭动态，等你来发布</view><view class="card moment" wx:for="{{moments}}" wx:key="id"><view class="row"><text class="author">{{item.author}}</text><text class="date">{{item.date}}</text></view><view wx:if="{{item.text}}" class="content">{{item.text}}</view><image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill" data-src="{{item.photo}}" bindtap="preview"/><text wx:if="{{item.author==='我'}}" class="delete" data-id="{{item.id}}" bindtap="remove">删除</text></view></view>
