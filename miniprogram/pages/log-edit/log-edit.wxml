<view class="page"><view class="title">{{id?'编辑记录':'记下这一餐'}}</view><view class="subtitle">简单记一笔，慢慢看见饮食习惯</view><view class="card"><text class="label">吃了什么</text><input value="{{dish}}" placeholder="例如：番茄牛腩饭" data-key="dish" bindinput="field"/><view class="two"><view><text class="label">日期</text><picker mode="date" value="{{date}}" bindchange="date"><view class="picker">{{date}}</view></picker></view><view><text class="label">时间</text><picker mode="time" value="{{mealTime}}" bindchange="time"><view class="picker">{{mealTime}}</view></picker></view></view><text class="label">就餐方式</text><picker range="{{types}}" bindchange="type"><view class="picker">{{mealType}}⌄</view></picker><text class="label">花费（可不填）</text><input type="digit" value="{{amount}}" placeholder="0" data-key="amount" bindinput="field"/><text class="label">健康标签</text><view><text wx:for="{{tagOptions}}" wx:key="name" class="tag {{item.selected?'chosen':''}}" data-tag="{{item.name}}" bindtap="toggle">{{item.name}}</text></view><text class="label">备注</text><textarea value="{{note}}" placeholder="今天的味道、心情或想对 TA 说的话" data-key="note" bindinput="field"/><button class="primary" bindtap="save">保存记录</button></view></view>
